# Database Configuration
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=players_production

# Rails Configuration
SECRET_KEY_BASE=your_secret_key_base_here_generate_with_rails_secret
RAILS_ENV=production
RACK_ENV=production

# Domain Configuration (for Caddy)
DOMAIN=players.billymartinplayersleague.com

# Application Host (for Rails host authorization)
APP_HOST=players.billymartinplayersleague.com

# Additional Trusted Hosts (optional, comma-separated, no wildcards)
# TRUSTED_HOSTS=www.players.billymartinplayersleague.com,api.players.billymartinplayersleague.com

# Cloudflare Tunnel Token
# Get this from: https://one.dash.cloudflare.com/
# Create a tunnel and copy the token
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Optional: Additional Rails configs
# RAILS_MAX_THREADS=5
# RAILS_LOG_LEVEL=info
