# =============================================================================
# Portainer Stack Environment Variables
# =============================================================================
# This file contains environment variables for deploying the Players app
# in Portainer. Copy these values into Portainer's Environment Variables
# section when creating your stack.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
DATABASE_NAME=players_production
DATABASE_HOST=db

# -----------------------------------------------------------------------------
# Rails Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 64
# Or with Rails: rails secret
SECRET_KEY_BASE=GENERATE_SECURE_KEY_WITH_openssl_rand_hex_64

RAILS_ENV=production

# -----------------------------------------------------------------------------
# Mailgun SMTP Configuration (REQUIRED for production)
# -----------------------------------------------------------------------------
MAILGUN_SMTP_ADDRESS=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_DOMAIN=billymartinplayersleague.com
MAILGUN_SMTP_USERNAME=postmaster@mg.billymartinplayersleague.com
MAILGUN_SMTP_PASSWORD=YOUR_MAILGUN_SMTP_PASSWORD_HERE
MAILGUN_SMTP_AUTHENTICATION=plain
MAILER_FROM=no-reply@billymartinplayersleague.com

# -----------------------------------------------------------------------------
# Caddy Proxy Configuration (REQUIRED for Caddy setup)
# -----------------------------------------------------------------------------
# Since Caddy handles SSL termination, Rails should not force SSL
DISABLE_FORCE_SSL=true

# Enable stdout logging for container logs (recommended)
RAILS_LOG_TO_STDOUT=true

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------
# Set your domain name (Caddy will proxy to this app)
# APP_HOST=yourdomain.com

# Uncomment if you need to serve static files directly from Rails
# (Usually not needed - let Caddy serve static files for better performance)
# RAILS_SERVE_STATIC_FILES=true

# Uncomment to set custom asset host (e.g., CDN)
# ASSET_HOST=https://assets.yourdomain.com
