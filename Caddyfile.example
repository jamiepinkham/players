# Caddy Configuration for Billy Martin Players League
# This is a reference configuration for your external Caddy proxy
# Update your actual Caddyfile with these routes

# Root domain redirect to blog
billymartinplayersleague.com {
    redir https://blog.billymartinplayersleague.com{uri} permanent
}

# Blog subdomain → Ghost CMS
blog.billymartinplayersleague.com {
    reverse_proxy ghost:2368
}

# Players subdomain → Rails app
players.billymartinplayersleague.com {
    reverse_proxy players:3000
}

# Admin subdomain → Rails app /admin path
admin.billymartinplayersleague.com {
    # Rewrite all requests to /admin path
    rewrite * /admin{uri}
    reverse_proxy players:3000
}

# QA subdomain → Rails app (testing environment - can point to any branch via IMAGE_TAG)
qa.billymartinplayersleague.com {
    reverse_proxy players-web-qa:3000
}

# Notes:
# - Caddy must be on the same Docker network as your services
# - Service names (ghost:2368, players:3000) are resolved via Docker network
# - SSL/TLS is handled automatically by Caddy using Let's Encrypt
# - The admin subdomain rewrites requests to the /admin path in Rails
# - The QA environment uses a separate stack (players-qa) for testing branches
