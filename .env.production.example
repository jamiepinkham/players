# =================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env.production and fill in real values
# DO NOT commit .env.production to version control
# =================================================================

# -----------------------------
# REQUIRED - Application will fail without these
# -----------------------------

# Rails Environment (MUST be 'production')
RAILS_ENV=production
RACK_ENV=production

# Secret Key Base (Generate with: rails secret or openssl rand -hex 64)
# CRITICAL: Use a unique, random value for production
SECRET_KEY_BASE=your_secret_key_base_here_change_this_to_a_long_random_string

# Database Configuration
DATABASE_HOST=db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_database_password_here
DATABASE_NAME=players_production

# -----------------------------
# RECOMMENDED - Should be set for production
# -----------------------------

# Rails Logging
RAILS_LOG_TO_STDOUT=true
RAILS_LOG_LEVEL=info

# Static Files (set to 'true' if not using CDN/nginx)
RAILS_SERVE_STATIC_FILES=true

# Rails Max Threads (Puma concurrency)
RAILS_MAX_THREADS=5

# Port (default: 3000)
PORT=3000

# -----------------------------
# OPTIONAL - Advanced Configuration
# -----------------------------

# Web Concurrency (Puma workers - uncomment to enable)
# WEB_CONCURRENCY=2

# CORS Origins (comma-separated list)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Action Mailer (if sending emails)
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_DOMAIN=yourdomain.com
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# MAILER_FROM=noreply@yourdomain.com

# Asset Host (if using CDN)
# ASSET_HOST=https://cdn.yourdomain.com

# Application Host/Domain
APP_HOST=players.billymartinplayersleague.com

# -----------------------------
# SECURITY - Additional Security Settings
# -----------------------------

# Force SSL (HTTPS enforcement is ENABLED in production)
# This is configured in config/environments/production.rb
# All HTTP requests will be redirected to HTTPS

# Trusted Hosts (comma-separated list, NO wildcards)
# IMPORTANT: List all hostnames that should accept requests
# Do NOT use wildcards like *.example.com
# TRUSTED_HOSTS=www.players.billymartinplayersleague.com,api.players.billymartinplayersleague.com

# -----------------------------
# NOTES
# -----------------------------
# 1. Generate SECRET_KEY_BASE with: docker run --rm ruby:3.1.2-slim bash -c "gem install bundler && rails secret"
# 2. Never use default/example values in production
# 3. Keep DATABASE_PASSWORD secure and complex
# 4. Rotate SECRET_KEY_BASE periodically (requires user re-login)
# 5. Set RAILS_LOG_LEVEL to 'warn' or 'error' after initial deployment
