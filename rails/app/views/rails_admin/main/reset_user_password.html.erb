<div class="page-header">
  <h1>Reset Password for <%= @object.username %></h1>
</div>

<div class="row">
  <div class="col-md-8">
    <%= form_tag reset_user_password_path(model_name: @abstract_model.to_param, id: @object.id), method: :post, class: 'form-horizontal' do %>
      <div class="form-group">
        <label class="col-sm-3 control-label">Username</label>
        <div class="col-sm-9">
          <p class="form-control-static"><strong><%= @object.username %></strong></p>
          <p class="help-block">
            You are resetting the password for this user.
          </p>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-3 control-label">New Password</label>
        <div class="col-sm-9">
          <%= password_field_tag :password, nil, class: 'form-control', required: true, minlength: 8, maxlength: 72, autocomplete: 'new-password' %>
          <p class="help-block">
            Must be 8-72 characters long.
          </p>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-3 control-label">Confirm Password</label>
        <div class="col-sm-9">
          <%= password_field_tag :password_confirmation, nil, class: 'form-control', required: true, minlength: 8, maxlength: 72, autocomplete: 'new-password' %>
          <p class="help-block">
            Re-enter the password to confirm.
          </p>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-3 col-sm-9">
          <div class="alert alert-warning">
            <strong>Important:</strong> You must manually notify the user of their new password. The password will be displayed once after reset.
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-3 col-sm-9">
          <%= submit_tag "Reset Password", class: 'btn btn-primary' %>
          <%= link_to "Cancel", index_path, class: 'btn btn-default' %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-md-4">
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title">Password Reset Guidelines</h3>
      </div>
      <div class="panel-body">
        <p><strong>This action will:</strong></p>
        <ol>
          <li>Set a new password for the user</li>
          <li>Invalidate their current sessions</li>
          <li>Display the new password once (for you to communicate to them)</li>
        </ol>

        <p class="text-info"><strong>Best Practices:</strong></p>
        <ul>
          <li>Use a secure method to communicate the password (Slack DM, Discord, etc.)</li>
          <li>Encourage the user to change their password after logging in</li>
          <li>Never send passwords via unsecured channels</li>
        </ul>

        <p class="text-warning"><strong>Note:</strong> The user will be logged out of all active sessions and will need to log in with the new password.</p>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title">User Information</h3>
      </div>
      <div class="panel-body">
        <dl>
          <dt>Username</dt>
          <dd><%= @object.username %></dd>

          <dt>Name</dt>
          <dd><%= @object.name || 'Not set' %></dd>

          <dt>Admin</dt>
          <dd><%= @object.is_admin? ? 'Yes' : 'No' %></dd>

          <dt>Team</dt>
          <dd><%= @object.team&.name || 'None' %></dd>

          <dt>Last Sign In</dt>
          <dd><%= @object.last_sign_in_at&.strftime('%Y-%m-%d %H:%M') || 'Never' %></dd>
        </dl>
      </div>
    </div>
  </div>
</div>
