<div class="page-header">
  <h1>Deactivate Expired Contracts</h1>
</div>

<div class="row">
  <div class="col-md-8">
    <%= form_tag deactivate_contracts_path, method: :post, class: 'form-horizontal' do %>
      <div class="form-group">
        <label class="col-sm-2 control-label">Current Season</label>
        <div class="col-sm-10">
          <%= select_tag :season_id,
              options_from_collection_for_select(Season.order(id: :desc), :id, :name, Season.current&.id),
              class: 'form-control',
              required: true %>
          <p class="help-block">
            Select the current season. All contracts ending before this season will be deactivated.
          </p>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <div class="alert alert-warning">
            <strong>Warning:</strong> This will set <code>active = false</code> on all contracts where <code>last_season_id &lt; selected_season_id</code>
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <%= submit_tag "Deactivate Expired Contracts", class: 'btn btn-primary' %>
          <%= link_to "Cancel", dashboard_path, class: 'btn btn-default' %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-md-4">
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title">How This Works</h3>
      </div>
      <div class="panel-body">
        <p><strong>This action will:</strong></p>
        <ol>
          <li>Find all contracts with <code>active = true</code></li>
          <li>Filter to contracts where <code>last_season_id &lt; selected_season</code></li>
          <li>Set <code>active = false</code> on those contracts</li>
          <li>Show you how many contracts were deactivated</li>
        </ol>

        <p class="text-muted"><strong>Example:</strong><br>
        If you select "2026" as the current season, all contracts ending in 2025 or earlier will be deactivated.</p>

        <p class="text-warning"><strong>Note:</strong> This is typically run at the start of a new season, right before importing new player stats.</p>
      </div>
    </div>
  </div>
</div>
