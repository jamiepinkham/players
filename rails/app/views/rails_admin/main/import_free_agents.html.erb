<div class="page-header">
  <h1>Import Free Agents</h1>
</div>

<div class="row">
  <div class="col-md-8">
    <%= form_tag import_free_agents_path, method: :post, multipart: true, class: 'form-horizontal' do %>
      <div class="form-group">
        <label class="col-sm-2 control-label">Hitters CSV</label>
        <div class="col-sm-10">
          <%= file_field_tag :hitters_file, accept: '.csv', class: 'form-control', required: true %>
          <p class="help-block">
            <strong>Expected columns:</strong> Player, BBRefID, PA, R, HR, RBI, SB, BA, OBP, SLG, OPS, WAR, Pos</strong>
          </p>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-2 control-label">Pitchers CSV</label>
        <div class="col-sm-10">
          <%= file_field_tag :pitchers_file, accept: '.csv', class: 'form-control', required: true %>
          <p class="help-block">
            <strong>Expected columns:</strong> Player, BBRefID, GS (games started), and IP, ERA, W, L, SV, G, GS, K/9, BB/9, HR/9, WAR</strong>
          </p>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <div class="alert alert-warning">
            <strong>Warning:</strong> This will clear all existing player stats before importing both files.
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
          <%= submit_tag "Import Free Agents", class: 'btn btn-primary' %>
          <%= link_to "Cancel", index_path(model_name: 'player'), class: 'btn btn-default' %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-md-4">
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title">Import Details</h3>
      </div>
      <div class="panel-body">
        <p><strong>What happens during import:</strong></p>
        <ol>
          <li>All existing player stats are cleared (once)</li>
          <li>Hitters CSV is processed:
            <ul>
              <li>Name from Player column</li>
              <li>Position from Pos column</li>
              <li>All other stats stored as JSON</li>
            </ul>
          </li>
          <li>Pitchers CSV is processed:
            <ul>
              <li>Name from Player column</li>
              <li>Position: SP if GS >= 5, else RP</li>
              <li>All stats stored as JSON</li>
            </ul>
          </li>
          <li>Players matched by BBRefID</li>
        </ol>
      </div>
    </div>
  </div>
</div>
