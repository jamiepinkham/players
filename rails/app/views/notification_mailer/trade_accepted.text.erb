  - Cash: <%= number_to_currency(@trade.to_cash_amount) %>
<% end %>

<%= @trade.to_team.name %> receives:
<% @trade.from_contracts.each do |contract| %>
  - <%= contract.player.name %> (<%= contract.player.position %>) - <%= number_to_currency(contract.amount) %>/year
<% end %>
<% if @trade.from_cash_amount.present? && @trade.from_cash_amount > 0 %>
  - Cash: <%= number_to_currency(@trade.from_cash_amount) %>
<% end %>

