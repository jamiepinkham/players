FROM ruby:3.1.2

# OS deps
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential libpq-dev postgresql-client ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

# Node + Yarn (from Debian repos; simple and reliable)
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    nodejs npm \
  && npm install -g yarn \
  && rm -rf /var/lib/apt/lists/*

# 🔒 Non-root user
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

WORKDIR /app

# Ruby deps (cacheable)
COPY rails/Gemfile rails/Gemfile.lock ./
RUN gem install -N foreman && bundle config set without 'test' \
  && bundle install

# App code
COPY rails/ ./

RUN chown -R appuser:appgroup /app
USER appuser

ENV DB_USERNAME_LINK bmpl-secrets/prod-db-username
ENV DB_PW_LINK bmpl-secrets/prod-db-password

EXPOSE 3000
CMD ["foreman", "start", "-f", "Procfile"]
