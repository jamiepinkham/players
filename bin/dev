#!/usr/bin/env bash
set -euo pipefail

# Extract OP_CONNECT_HOST and OP_CONNECT_TOKEN from the template and export them
export OP_CONNECT_HOST=$(grep '^OP_CONNECT_HOST=' .env.template | cut -d '=' -f2-)
export OP_CONNECT_TOKEN=$(grep '^OP_CONNECT_TOKEN=' .env.template | cut -d '=' -f2-)

echo "🔐 Injecting development secrets from 1Password..."

bin/validate-env .env.template   

op inject -i .env.template -o .env

echo "🚀 Starting development environment (players-dev)..."
docker-compose --env-file .env up "$@"

# Optional cleanup (comment out if you want to inspect .env after)
trap 'rm -f .env' EXIT