#!/usr/bin/env bash
set -euo pipefail

HEROKU_APP="${1:-}"
LOCAL_DB="${2:-players_development}"
ENVIRONMENT="${3:-dev}"
PG_CONTAINER_NAME="${4:-db}"  # Default Postgres container name in Compose

if [[ -z "$HEROKU_APP" || -z "$LOCAL_DB" ]]; then
  echo "❌ Usage: $0 <heroku-app-name> <local-db-name> [environment=dev] [pg-container-name=db]"
  echo "Example: $0 myapp-staging players_development"
  echo "         $0 myapp-prod players_production production db"
  exit 1
fi

if [[ "$ENVIRONMENT" != "dev" && "$ENVIRONMENT" != "production" ]]; then
  echo "❌ Invalid environment: $ENVIRONMENT (must be 'dev' or 'production')"
  exit 1
fi

# 🔐 Read Postgres credentials for the given environment from 1Password
echo "🔐 Reading Postgres credentials from 1Password for environment: $ENVIRONMENT"
PG_USER=$(op read --no-newline "op://bmpl/postgres-${ENVIRONMENT}/username")
PG_PASS=$(op read --no-newline "op://bmpl/postgres-${ENVIRONMENT}/password")

# 🐳 Ensure the Postgres container is running
echo "⏳ Waiting for Postgres to be ready..."
# Defaults
PG_CONTAINER_NAME="${PG_CONTAINER_NAME:-db}"
PG_USER="${PG_USER:-postgres}"

echo "🔍 Checking if Postgres container '$PG_CONTAINER_NAME' is running..."

if ! docker ps --format '{{.Names}}' | grep -q "^$PG_CONTAINER_NAME$"; then
  echo "🚀 Starting Postgres container '$PG_CONTAINER_NAME' via Docker Compose..."
  docker compose up -d "$PG_CONTAINER_NAME"
else
  echo "✅ Postgres container is already running."
fi

echo "⏳ Waiting for Postgres to be ready (via pg_isready)..."
LOG_PID_FILE="/tmp/${PG_CONTAINER_NAME}_startup_log.pid"

# Stream logs in the background for debugging
docker logs -f "$PG_CONTAINER_NAME" &
LOG_PID=$!
echo "$LOG_PID" > "$LOG_PID_FILE"

# Wait until pg_isready succeeds
until docker exec "$PG_CONTAINER_NAME" pg_isready -U "$PG_USER" >/dev/null 2>&1; do
  sleep 1
done

# Kill log stream
kill "$LOG_PID" 2>/dev/null || true
wait "$LOG_PID" 2>/dev/null || true
rm -f "$LOG_PID_FILE"

echo "✅ Postgres container '$PG_CONTAINER_NAME' is ready."



# 📦 Pull Heroku DB backup
FILENAME="heroku_backup_$(date +%Y%m%d_%H%M%S).dump"
echo "📦 Pulling latest Heroku Postgres backup from: $HEROKU_APP"
heroku pg:backups:capture --app "$HEROKU_APP"
curl -o "$FILENAME" "$(heroku pg:backups:url --app "$HEROKU_APP")"

# 🧨 Drop and recreate local DB
echo "🧨 Dropping local database: $LOCAL_DB"
docker exec -e PGPASSWORD="$PG_PASS" "$PG_CONTAINER_NAME" dropdb -U "$PG_USER" "$LOCAL_DB" --if-exists

echo "🗄 Creating new local database: $LOCAL_DB"
docker exec -e PGPASSWORD="$PG_PASS" "$PG_CONTAINER_NAME" createdb -U "$PG_USER" "$LOCAL_DB"

# 📥 Restore backup
echo "⏳ Restoring backup into $LOCAL_DB"
docker cp "$FILENAME" "$PG_CONTAINER_NAME":/tmp/"$FILENAME"
docker exec -e PGPASSWORD="$PG_PASS" "$PG_CONTAINER_NAME" \
  pg_restore --verbose --clean --no-acl --no-owner -U "$PG_USER" -d "$LOCAL_DB" /tmp/"$FILENAME"

echo "✅ Local database '$LOCAL_DB' successfully restored from '$HEROKU_APP'."
