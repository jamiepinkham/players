#!/usr/bin/env bash
set -euo pipefail

echo "🔧 Setting up your development environment..."

if ! command -v brew &>/dev/null; then
  echo "❌ brew is not installed or not in your PATH."
  exit 1
fi

brew install colima lima qemu docker docker-compose 

# Copy .env file if it's not already there
if [[ ! -f .env ]]; then
  echo "📄 Creating .env from template..."
  cp .env.template .env
else
  echo "📄 .env already exists, skipping copy."
fi

echo "🐳 Booting up database container..."
docker compose --env-file .env up -d db

echo "✅ Setup complete."
echo "👉 Run ./bin/dev to start the application."
