#!/usr/bin/env bash

op_test() {
  if [[ -z "${OP_CONNECT_HOST:-}" || -z "${OP_CONNECT_TOKEN:-}" ]]; then
    echo "❌ OP_CONNECT_HOST and/or OP_CONNECT_TOKEN are not set."
    op_prompt
  fi

  echo "🔐 OP_CONNECT_* already set."
  echo "🔍 Verifying secrets access... ${OP_CONNECT_HOST}"

  # Make the request with verbose output and show status code last
  response=$(curl -s \
    -H "Authorization: Bearer $OP_CONNECT_TOKEN" \
    -w "\nHTTP_STATUS:%{http_code}" \
    "$OP_CONNECT_HOST/v1/vaults")

  # Separate body and status
  status=$(echo "$response" | grep '^HTTP_STATUS:' | cut -d':' -f2)
  echo "🔢 Status code: $status"

  if [[ "$status" == "200" ]]; then
    echo "✅ Successfully connected to 1Password Connect"
    return 0
  else
    echo "❌ Failed to connect to 1Password Connect"
    return 1
  fi
}

op_prompt() {
  if [[ -z "${OP_CONNECT_HOST:-}" ]]; then
    read -rp "Enter OP_CONNECT_HOST (e.g. https://connect-api.example.ts.net): " input_host
    if [[ -z "$input_host" ]]; then
      echo "❌ OP_CONNECT_HOST cannot be empty."
      return 1
    fi
    export OP_CONNECT_HOST="$input_host"
  fi

  if [[ -z "${OP_CONNECT_TOKEN:-}" ]]; then
    read -rsp "Enter OP_CONNECT_TOKEN: " input_token
    echo ""
    if [[ -z "$input_token" ]]; then
      echo "❌ OP_CONNECT_TOKEN cannot be empty."
      return 1
    fi
    export OP_CONNECT_TOKEN="$input_token"
  fi

  echo "✅ OP_CONNECT_* environment variables set."
}


