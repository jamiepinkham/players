#!/usr/bin/env bash
set -euo pipefail

# Extract OP_CONNECT_HOST and OP_CONNECT_TOKEN from the template and export them
export OP_CONNECT_HOST=$(grep '^OP_CONNECT_HOST=' .env.template | cut -d '=' -f2-)
export OP_CONNECT_TOKEN=$(grep '^OP_CONNECT_TOKEN=' .env.template | cut -d '=' -f2-)

echo $OP_CONNECT_HOST
echo $OP_CONNECT_TOKEN


TEMPLATE_FILE="${1:-.env.template}"

if [[ ! -f "$TEMPLATE_FILE" ]]; then
  echo "❌ File not found: $TEMPLATE_FILE"
  exit 1
fi

echo "🔍 Validating secrets in $TEMPLATE_FILE..."

refs=$(grep -oE 'op://[^ ]+' "$TEMPLATE_FILE" | sort -u)
missing=0

for ref in $refs; do
  vault_and_item=$(echo "$ref" | cut -d/ -f3,4)
  field=$(echo "$ref" | cut -d/ -f5-)

  if op read "$ref" > /dev/null 2>&1; then
    echo "✅ $vault_and_item → $field"
  else
    echo "❌ Missing or unreadable: $ref"
    missing=1
  fi
done

if [[ "$missing" -eq 1 ]]; then
  echo "🛑 One or more secrets are missing from 1Password."
  exit 1
fi

echo "✅ All secrets validated!"
