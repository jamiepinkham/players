#!/usr/bin/env bash
set -euo pipefail

# fail fast if any of our required tools aren't installed
REQUIRED_TOOLS=(docker-compose git op)
for tool in "${REQUIRED_TOOLS[@]}"; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "❌ Required tool '$tool' is not installed or not in PATH."
    exit 1
  fi
done

APP_PATH="${1:-}"
ENVIRONMENT="${2:-dev}"

if [[ -z "$APP_PATH" || -z "$ENVIRONMENT" ]]; then
  echo "❌ Usage: $0 /path/to/app [dev|production]"
  exit 1
fi

if [[ "$ENVIRONMENT" != "dev" && "$ENVIRONMENT" != "production" ]]; then
  echo "❌ Invalid environment: $ENVIRONMENT"
  exit 1
fi

TEMPLATE_FILE="$APP_PATH/.env.${ENVIRONMENT}.template"
ENV_FILE="$APP_PATH/.env.${ENVIRONMENT}"
REPO="jamiepinkham/players"  # <-- UPDATE THIS

source "$(dirname "$0")/secrets-helper"
op_test || exit 1

# Inject application secrets (excluding OP secrets)
echo "🔐 Injecting secrets from 1Password..."
op inject -i "$TEMPLATE_FILE" -o "$ENV_FILE"
trap 'rm -f "$ENV_FILE"' EXIT

echo "📁 Deploying to: $APP_PATH"
mkdir -p "$APP_PATH"
cd "$APP_PATH"

# Get GitHub PAT from injected .env
GITHUB_PAT=$(op read op://bmpl/secrets/github/pat)
REPO_URL="https://${GITHUB_PAT}@github.com/${REPO}.git"

# Clone or pull
if [[ ! -d ".git" ]]; then
  echo "📦 Cloning $REPO..."
  git clone "$REPO_URL" .
else
  echo "🔄 Pulling latest changes..."
  git pull origin main
fi

# Make sure scripts are executable
chmod +x start.sh stop.sh restart.sh || true

# Restart
./restart.sh "$ENVIRONMENT"

echo "✅ Deployment complete for $ENVIRONMENT."
