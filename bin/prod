#!/usr/bin/env bash
set -euo pipefail

# Extract OP_CONNECT_HOST and OP_CONNECT_TOKEN from the template and export them
export OP_CONNECT_HOST=$(grep '^OP_CONNECT_HOST=' .env.production.template | cut -d '=' -f2-)
export OP_CONNECT_TOKEN=$(grep '^OP_CONNECT_TOKEN=' .env.production.template | cut -d '=' -f2-)

echo "🔐 Injecting production secrets from 1Password..."

bin/validate-env .env.production.template

op inject -i .env.production.template -o .env.production

echo "🚀 Starting production stack (players)..."
docker-compose \
  --env-file .env \
  up "$@"

# Optional cleanup
trap 'rm -f .env.production' EXIT
