#!/usr/bin/env bash
set -euo pipefail

ENVIRONMENT="${1:-dev}"

if [[ "$ENVIRONMENT" != "dev" && "$ENVIRONMENT" != "production" ]]; then
  echo "❌ Invalid environment: $ENVIRONMENT"
  echo "Usage: $0 [dev|production]"
  exit 1
fi

if ! command -v docker-compose >/dev/null 2>&1; then
  echo "❌ docker-compose is not installed"
  exit 1
fi

# File paths
COMPOSE_FILE="docker-compose.${ENVIRONMENT}.yml"
[[ -f "$COMPOSE_FILE" ]] || COMPOSE_FILE="docker-compose.yml"

ENV_FILE=".env${ENVIRONMENT:+.${ENVIRONMENT}}"

# Log file
LOG_DIR="logs"
LOG_FILE="${LOG_DIR}/${ENVIRONMENT}_stop_$(date +%Y%m%d_%H%M%S).log"
mkdir -p "$LOG_DIR"

echo "🛑 Stopping $ENVIRONMENT stack using $COMPOSE_FILE..." | tee -a "$LOG_FILE"

# Attempt to find and stop any backgrounded `nohup docker-compose` jobs
echo "🔍 Checking for backgrounded docker-compose processes..." | tee -a "$LOG_FILE"
PIDS=$(pgrep -f "docker-compose -f $COMPOSE_FILE")

if [[ -n "$PIDS" ]]; then
  echo "🚫 Found background docker-compose PIDs: $PIDS" | tee -a "$LOG_FILE"
  echo "$PIDS" | xargs kill -15 || true
else
  echo "✅ No matching background processes found." | tee -a "$LOG_FILE"
fi

# Bring down the stack
docker-compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" down -v | tee -a "$LOG_FILE"

# Remove injected env file
if [[ -f "$ENV_FILE" ]]; then
  if rm -f "$ENV_FILE"; then
    echo "🧹 Removed $ENV_FILE" | tee -a "$LOG_FILE"
  else
    echo "⚠️  Failed to remove $ENV_FILE" | tee -a "$LOG_FILE"
  fi
else
  echo "ℹ️  No env file to clean up." | tee -a "$LOG_FILE"
fi

echo "✅ $ENVIRONMENT stack stopped and cleaned up." | tee -a "$LOG_FILE"
