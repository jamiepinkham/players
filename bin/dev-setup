#!/usr/bin/env bash
# Complete development environment setup script
# This script handles everything needed to get a local dev environment running

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Change to project root
cd "$(dirname "$0")/.."

echo -e "${BLUE}=============================================${NC}"
echo -e "${BLUE}   Players Local Development Setup${NC}"
echo -e "${BLUE}=============================================${NC}"
echo ""

# Step 1: Check Docker
echo -e "${BLUE}[1/6]${NC} Checking Docker..."
if ! command -v docker &>/dev/null; then
  echo -e "${RED}❌ Docker is not installed${NC}"
  echo ""
  echo "Please install Docker Desktop:"
  echo "  https://www.docker.com/products/docker-desktop"
  echo ""
  exit 1
fi

if ! docker info &>/dev/null; then
  echo -e "${RED}❌ Docker is not running${NC}"
  echo ""
  echo "Please start Docker Desktop and try again."
  echo ""
  exit 1
fi

echo -e "${GREEN}✓ Docker is installed and running${NC}"
echo ""

# Step 2: Check .env file
echo -e "${BLUE}[2/6]${NC} Setting up environment variables..."
if [[ ! -f .env ]]; then
  echo "Creating .env from template..."
  cp .env.template .env
  echo -e "${GREEN}✓ Created .env file${NC}"
else
  echo -e "${GREEN}✓ .env file already exists${NC}"
fi
echo ""

# Step 3: Build Docker images
echo -e "${BLUE}[3/6]${NC} Building Docker images..."
echo "This may take a few minutes on first run..."
if docker compose build --quiet; then
  echo -e "${GREEN}✓ Docker images built successfully${NC}"
else
  echo -e "${RED}❌ Failed to build Docker images${NC}"
  exit 1
fi
echo ""

# Step 4: Start database
echo -e "${BLUE}[4/6]${NC} Starting PostgreSQL database..."
docker compose up -d db

echo "Waiting for database to be ready..."
MAX_ATTEMPTS=30
ATTEMPT=0
while [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do
  if docker compose exec -T db pg_isready -U postgres &>/dev/null; then
    echo -e "${GREEN}✓ Database is ready${NC}"
    break
  fi
  ATTEMPT=$((ATTEMPT + 1))
  if [ $ATTEMPT -eq $MAX_ATTEMPTS ]; then
    echo -e "${RED}❌ Database failed to start${NC}"
    echo "Check logs with: docker compose logs db"
    exit 1
  fi
  sleep 1
done
echo ""

# Step 5: Restore database or seed
echo -e "${BLUE}[5/6]${NC} Setting up database..."
RESTORE_FILE="docker/db/restore/latest.restore"

if [[ -f "$RESTORE_FILE" ]]; then
  echo "Found database restore file: $RESTORE_FILE"
  echo "Restoring database from dump..."

  # Load environment variables
  export $(grep -v '^#' .env | xargs -0)

  # Create database if it doesn't exist
  docker compose run --rm players bundle exec rails db:create 2>/dev/null || echo "Database may already exist"

  # Restore from dump
  if docker compose run --rm -e PGPASSWORD="$DATABASE_PASSWORD" players \
    pg_restore --clean --no-owner -U "$DATABASE_USER" -h db --dbname="$DATABASE_NAME" /app/db/restore/latest.restore; then
    echo -e "${GREEN}✓ Database restored from dump${NC}"
  else
    echo -e "${YELLOW}⚠️  Restore completed with warnings (this is often normal)${NC}"
  fi

  # Run migrations
  docker compose run --rm players bundle exec rails db:migrate
  echo -e "${GREEN}✓ Migrations complete${NC}"
else
  echo "No restore file found at $RESTORE_FILE"
  echo "Creating fresh database with seeds..."

  docker compose run --rm players bundle exec rails db:create db:migrate db:seed
  echo -e "${GREEN}✓ Database created and seeded${NC}"
fi
echo ""

# Step 6: Install dependencies
echo -e "${BLUE}[6/6]${NC} Installing dependencies..."
echo "Installing Ruby gems..."
docker compose run --rm players bundle install --quiet
echo -e "${GREEN}✓ Ruby gems installed${NC}"

echo "Installing JavaScript packages..."
docker compose run --rm assets yarn install --silent
echo -e "${GREEN}✓ JavaScript packages installed${NC}"
echo ""

# Success message
echo -e "${GREEN}=============================================${NC}"
echo -e "${GREEN}   ✓ Development Environment Ready!${NC}"
echo -e "${GREEN}=============================================${NC}"
echo ""
echo "To start the application:"
echo -e "  ${YELLOW}./bin/dev${NC}"
echo ""
echo "The application will be available at:"
echo -e "  ${YELLOW}http://localhost:3000${NC}"
echo ""
echo "Useful commands:"
echo "  ./bin/dev              - Start development server"
echo "  ./bin/rails console    - Open Rails console"
echo "  ./bin/rails db:reset   - Reset database"
echo "  docker compose logs    - View logs"
echo "  docker compose down    - Stop all services"
echo ""
echo "To restore database again:"
echo "  ./bin/restore"
echo ""
