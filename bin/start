#!/usr/bin/env bash
set -euo pipefail

ENVIRONMENT="${1:-dev}"
shift || true

# Default: foreground mode
BACKGROUND=false

# Check for --background flag
if [[ "${1:-}" == "--background" ]]; then
  BACKGROUND=true
  shift
fi

if [[ "$ENVIRONMENT" != "dev" && "$ENVIRONMENT" != "production" ]]; then
  echo "❌ Invalid environment: $ENVIRONMENT"
  echo "Usage: $0 [dev|production] [--background] [docker-compose args...]"
  exit 1
fi

# File paths
TEMPLATE_FILE=".env${ENVIRONMENT:+.${ENVIRONMENT}}.template"
ENV_FILE=".env${ENVIRONMENT:+.${ENVIRONMENT}}"
COMPOSE_FILE="docker-compose.${ENVIRONMENT}.yml"
[[ -f "$COMPOSE_FILE" ]] || COMPOSE_FILE="docker-compose.yml"

# Logging
LOG_DIR="logs"
mkdir -p "$LOG_DIR"
LOG_FILE="${LOG_DIR}/${ENVIRONMENT}_start_$(date +%Y%m%d_%H%M%S).log"

echo "🔧 Environment: $ENVIRONMENT"
echo "📄 Using env template: $TEMPLATE_FILE"
echo "📦 Using compose file: $COMPOSE_FILE"
echo "📂 Logging to: $LOG_FILE"

# Ensure op CLI is available
if ! command -v op >/dev/null 2>&1; then
  echo "❌ 1Password CLI (op) is not installed"
  exit 1
fi

source "$(dirname "$0")/secrets-helper"
op_test || exit 1


echo "🔐 Injecting secrets from 1Password..."
if [[ ! -x bin/validate-env ]]; then
  echo "❌ bin/validate-env not found or not executable"
  exit 1
fi

bin/validate-env "$TEMPLATE_FILE"
op inject -i "$TEMPLATE_FILE" -o "$ENV_FILE"

# Decide whether to clean up the env file
if [[ "$BACKGROUND" == true ]]; then
  echo "🚀 Starting $ENVIRONMENT stack in background via nohup..."
  echo "🧪 docker-compose -f $COMPOSE_FILE --env-file $ENV_FILE up $*" >> "$LOG_FILE"
  nohup docker-compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up "$@" > "$LOG_FILE" 2>&1 &
  echo "✅ $ENVIRONMENT stack launched in background."
  echo "📄 To monitor: tail -f $LOG_FILE"
else
  echo "🚀 Starting $ENVIRONMENT stack in foreground..."
  trap "rm -f \"$ENV_FILE\"" EXIT
  docker-compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up "$@"
fi
