# Rails defaults
rails/log/*
rails/tmp/*
!rails/log/.keep
!rails/tmp/.keep
rails/.bundle/
rails/db/*.sqlite3
rails/db/*.sqlite3-journal
rails/public/packs
rails/public/assets/*
!rails/public/assets/.keep
rails/app/assets/builds/
rails/public/packs-test
rails/public/system
rails/public/uploads
rails/.byebug_history
rails/storage/*
!rails/storage/.keep
rails/node_modules
rails/.yarn/cache
rails/.yarn/unplugged
rails/.yarn/install-state.gz
rails/.yarn/build-state.yml
rails/.yarn/patches
rails/.yarn/releases
rails/.yarn/versions
/rails/tmp/*
rails/node_modules

# Ignore master key if using credentials
rails/config/master.key

# dotenv files (ignore actual env, but commit templates)
.env
.env.production
.env.staging
.env.local
.env.*.local

# Portainer stack environment files (ignore actual values, commit template)
stack.env

# Allow templates to be committed
!.env.example
!.env.qa
!.env.prod
!stack.env.txt

# Yarn and lock files
rails/yarn-error.log

# macOS and IDE cruft
.DS_Store
.idea/
/.vscode/

# Docker
*.pid
*.sock
docker-compose.override.yml

# Optional: ignore system test screenshots
/tmp/screenshots/*

# Optional: if using foreman or Procfile-based setups
.procfile.dev

logs/*
*.dump

# Database restore files
db-restore/*
!db-restore/.gitkeep
